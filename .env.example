# Environment configuration for Scalable Video Streaming Platform

# Load Balancer & Edge
LB_PORT=8080

# MinIO Image & Credentials
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
S3_ENDPOINT=http://origin:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword123
S3_REGION=us-east-1
S3_RAW_BUCKET=raw
S3_VIDEOS_BUCKET=videos

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=videodb
DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/videodb

# Redis
REDIS_URL=redis://redis:6379

# Application Settings
JWT_SECRET=super_secret_jwt_key_video_streaming_2026_secure
MAX_UPLOAD_MB=1024
WORKER_CONCURRENCY=1
